rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3
        && request.auth.token.email.size() <= 160;
    }

    function isAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'josetejera44@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAllowedEmails(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 15
        && arr[0] is string
        && arr[0].size() >= 3
        && arr[0].size() <= 160;
    }

    function isOwnerOrAdmin(data) {
      return isVerifiedUser() && (
        data.ownerUid == request.auth.uid
        || isAdminEmail()
      );
    }

    function canAccessResource(data) {
      return isVerifiedUser() && (
        data.ownerUid == request.auth.uid
        || request.auth.token.email == 'josetejera44@gmail.com'
        || (data.allowedEmails is list && request.auth.token.email in data.allowedEmails)
      );
    }

    function hasValidBaseOwnership(data) {
      return data.ownerUid is string
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 160
        && isValidAllowedEmails(data.allowedEmails)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasImmutableBaseOwnership() {
      return incoming().ownerUid == existing().ownerUid
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    // --- Entity Validation Blueprints ---
    function isValidRegistro(data) {
      return data.keys().hasAll([
          'id', 'fecha', 'fdesp', 'turno', 'nombre', 'op', 'sap',
          'descripcion', 'cliente', 'pedido', 'empaque', 'u', 'c',
          'total', 'estado', 'creado', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fecha', 'fdesp', 'turno', 'nombre', 'op', 'sap',
          'descripcion', 'cliente', 'pedido', 'empaque', 'u', 'c',
          'total', 'estado', 'creado', 'ord', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.fecha is string && data.fecha.size() == 10 && data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.fdesp is string && data.fdesp.size() == 10 && data.fdesp.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.turno is string && data.turno in ['Día', 'Noche']
        && data.nombre is string && data.nombre.size() <= 100
        && data.op is string && data.op.size() >= 1 && data.op.size() <= 60
        && data.sap is string && data.sap.size() <= 120
        && data.descripcion is string && data.descripcion.size() <= 240
        && data.cliente is string && data.cliente.size() <= 140
        && data.pedido is int && data.pedido >= 0 && data.pedido <= 100000000
        && data.empaque is string && data.empaque.size() <= 20
        && data.u is int && data.u >= 0 && data.u <= 100000000
        && data.c is int && data.c >= 0 && data.c <= 100000000
        && data.total is int && data.total >= 0 && data.total <= 1000000000
        && data.estado is string && data.estado.size() <= 30
        && data.creado is string && data.creado.size() <= 40
        && (!('ord' in data) || (data.ord is int && data.ord >= 0 && data.ord <= 1000000))
        && hasValidBaseOwnership(data);
    }

    function isValidIngreso(data) {
      return data.keys().hasAll([
          'id', 'fecha', 'turno', 'nombre', 'op', 'sap',
          'descripcion', 'cliente', 'empaque', 'u', 'c',
          'total', 'creado', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fecha', 'turno', 'nombre', 'op', 'sap',
          'descripcion', 'cliente', 'empaque', 'u', 'c',
          'total', 'creado', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.fecha is string && data.fecha.size() == 10 && data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.turno is string && data.turno in ['Día', 'Noche']
        && data.nombre is string && data.nombre.size() <= 100
        && data.op is string && data.op.size() >= 1 && data.op.size() <= 60
        && data.sap is string && data.sap.size() <= 120
        && data.descripcion is string && data.descripcion.size() <= 240
        && data.cliente is string && data.cliente.size() <= 140
        && data.empaque is string && data.empaque.size() <= 20
        && data.u is int && data.u >= 0 && data.u <= 100000000
        && data.c is int && data.c >= 0 && data.c <= 100000000
        && data.total is int && data.total >= 0 && data.total <= 1000000000
        && data.creado is string && data.creado.size() <= 40
        && hasValidBaseOwnership(data);
    }

    function isValidDespachoPlan(data) {
      return data.keys().hasAll([
          'id', 'tipo', 'fdesp', 'archivo', 'items',
          'ownerUid', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'tipo', 'fdesp', 'archivo', 'items',
          'ownerUid', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.tipo is string && data.tipo in ['sap', 'op']
        && data.fdesp is string && data.fdesp.size() == 10 && data.fdesp.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.archivo is string && data.archivo.size() <= 160
        && data.items is list && data.items.size() <= 250
        && (data.items.size() == 0 || data.items[0] is map)
        && hasValidBaseOwnership(data);
    }

    function isValidOpExtra(data) {
      return data.keys().hasAll([
          'key', 'op', 'fdesp', 'enProduccion', 'cantPlanta',
          'ownerUid', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'key', 'op', 'fdesp', 'enProduccion', 'cantPlanta',
          'ownerUid', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 100
        && data.op is string && data.op.size() >= 1 && data.op.size() <= 60
        && data.fdesp is string && data.fdesp.size() <= 10
        && data.enProduccion is bool
        && data.cantPlanta is int && data.cantPlanta >= 0 && data.cantPlanta <= 100000000
        && hasValidBaseOwnership(data);
    }

    function isValidWorkspaceConfig(data) {
      return data.keys().hasAll([
          'nombres', 'teamEmails', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'nombres', 'teamEmails', 'ownerUid', 'ownerEmail',
          'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.nombres is list && data.nombres.size() <= 100
        && (data.nombres.size() == 0 || (data.nombres[0] is string && data.nombres[0].size() <= 100))
        && data.teamEmails is list && data.teamEmails.size() <= 15
        && (data.teamEmails.size() == 0 || (data.teamEmails[0] is string && data.teamEmails[0].size() <= 160))
        && hasValidBaseOwnership(data);
    }

    // --- Collection Rules ---
    match /registros/{regId} {
      allow get: if isValidId(regId) && canAccessResource(existing());
      allow list: if canAccessResource(existing());
      allow create: if isVerifiedUser()
        && isValidId(regId)
        && isValidRegistro(incoming())
        && incoming().id == regId
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().ownerEmail in incoming().allowedEmails
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(regId)
        && isValidRegistro(incoming())
        && canAccessResource(existing())
        && hasImmutableBaseOwnership()
        && incoming().id == existing().id
        && (
          // Tier 1 (Owner/Admin): Edit quantities, metadata or team access
          (isOwnerOrAdmin(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'fecha', 'fdesp', 'turno', 'nombre', 'sap', 'descripcion',
            'cliente', 'pedido', 'empaque', 'u', 'c', 'total', 'estado',
            'ord', 'allowedEmails', 'updatedAt'
          ]) && incoming().ownerEmail in incoming().allowedEmails)
          ||
          // Tier 2 (Team member): Edit operational fields only
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'fecha', 'fdesp', 'turno', 'nombre', 'sap', 'descripcion',
            'cliente', 'pedido', 'empaque', 'u', 'c', 'total', 'estado',
            'ord', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(regId) && canAccessResource(existing());
    }

    match /ingresos/{ingId} {
      allow get: if isValidId(ingId) && canAccessResource(existing());
      allow list: if canAccessResource(existing());
      allow create: if isVerifiedUser()
        && isValidId(ingId)
        && isValidIngreso(incoming())
        && incoming().id == ingId
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().ownerEmail in incoming().allowedEmails
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(ingId)
        && isValidIngreso(incoming())
        && canAccessResource(existing())
        && hasImmutableBaseOwnership()
        && incoming().id == existing().id
        && (
          // Tier 1 (Owner/Admin): Edit ingreso fields or team access
          (isOwnerOrAdmin(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'fecha', 'turno', 'nombre', 'sap', 'descripcion',
            'cliente', 'empaque', 'u', 'c', 'total', 'allowedEmails', 'updatedAt'
          ]) && incoming().ownerEmail in incoming().allowedEmails)
          ||
          // Tier 2 (Team member): Edit operational ingreso fields only
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'fecha', 'turno', 'nombre', 'sap', 'descripcion',
            'cliente', 'empaque', 'u', 'c', 'total', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(ingId) && canAccessResource(existing());
    }

    match /despachos_plan/{planDocId} {
      allow get: if isValidId(planDocId) && canAccessResource(existing());
      allow list: if canAccessResource(existing());
      allow create: if isVerifiedUser()
        && isValidId(planDocId)
        && isValidDespachoPlan(incoming())
        && incoming().id == planDocId
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().ownerEmail in incoming().allowedEmails
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(planDocId)
        && isValidDespachoPlan(incoming())
        && canAccessResource(existing())
        && hasImmutableBaseOwnership()
        && incoming().id == existing().id
        && (
          // Tier 1 (Owner/Admin): Replace dispatch plan items or team access
          (isOwnerOrAdmin(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'archivo', 'items', 'allowedEmails', 'updatedAt'
          ]) && incoming().ownerEmail in incoming().allowedEmails)
          ||
          // Tier 2 (Team member): Replace dispatch plan items only
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'archivo', 'items', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(planDocId) && canAccessResource(existing());
    }

    match /op_extras/{extraId} {
      allow get: if isValidId(extraId) && canAccessResource(existing());
      allow list: if canAccessResource(existing());
      allow create: if isVerifiedUser()
        && isValidId(extraId)
        && isValidOpExtra(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().ownerEmail in incoming().allowedEmails
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(extraId)
        && isValidOpExtra(incoming())
        && canAccessResource(existing())
        && hasImmutableBaseOwnership()
        && incoming().key == existing().key
        && (
          // Tier 1 (Owner/Admin): Update production/plant state or team access
          (isOwnerOrAdmin(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'enProduccion', 'cantPlanta', 'allowedEmails', 'updatedAt'
          ]) && incoming().ownerEmail in incoming().allowedEmails)
          ||
          // Tier 2 (Team member): Update production/plant state only
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'enProduccion', 'cantPlanta', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(extraId) && canAccessResource(existing());
    }

    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && canAccessResource(existing());
      allow list: if canAccessResource(existing());
      allow create: if isVerifiedUser()
        && isValidId(workspaceId)
        && isValidWorkspaceConfig(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().ownerEmail in incoming().allowedEmails
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(workspaceId)
        && isValidWorkspaceConfig(incoming())
        && canAccessResource(existing())
        && hasImmutableBaseOwnership()
        && (
          // Tier 1 (Owner/Admin): Manage habilitadores and authorized team emails
          (isOwnerOrAdmin(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'nombres', 'teamEmails', 'allowedEmails', 'updatedAt'
          ]) && incoming().ownerEmail in incoming().allowedEmails)
          ||
          // Tier 2 (Team member): Manage habilitadores only
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'nombres', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(workspaceId) && isOwnerOrAdmin(existing());
    }

    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
