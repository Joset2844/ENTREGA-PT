{
  "entities": {
    "Registro": {
      "title": "Registro de entrega",
      "description": "Registro individual o stock inicial asociado a una OP y fecha de despacho.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fecha": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fdesp": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "turno": { "type": "string", "enum": ["Día", "Noche"], "maxLength": 10 },
        "nombre": { "type": "string", "maxLength": 100 },
        "op": { "type": "string", "minLength": 1, "maxLength": 60 },
        "sap": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 240 },
        "cliente": { "type": "string", "maxLength": 140 },
        "pedido": { "type": "integer" },
        "empaque": { "type": "string", "maxLength": 20 },
        "u": { "type": "integer" },
        "c": { "type": "integer" },
        "total": { "type": "integer" },
        "estado": { "type": "string", "maxLength": 30 },
        "creado": { "type": "string", "maxLength": 40 },
        "ord": { "type": "integer" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "allowedEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "fecha",
        "fdesp",
        "turno",
        "nombre",
        "op",
        "sap",
        "descripcion",
        "cliente",
        "pedido",
        "empaque",
        "u",
        "c",
        "total",
        "estado",
        "creado",
        "ownerUid",
        "ownerEmail",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "Ingreso": {
      "title": "Ingreso a almacén",
      "description": "Ingreso de producción terminado hacia almacén.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fecha": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "turno": { "type": "string", "enum": ["Día", "Noche"], "maxLength": 10 },
        "nombre": { "type": "string", "maxLength": 100 },
        "op": { "type": "string", "minLength": 1, "maxLength": 60 },
        "sap": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 240 },
        "cliente": { "type": "string", "maxLength": 140 },
        "empaque": { "type": "string", "maxLength": 20 },
        "u": { "type": "integer" },
        "c": { "type": "integer" },
        "total": { "type": "integer" },
        "creado": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "allowedEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "fecha",
        "turno",
        "nombre",
        "op",
        "sap",
        "descripcion",
        "cliente",
        "empaque",
        "u",
        "c",
        "total",
        "creado",
        "ownerUid",
        "ownerEmail",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "DespachoPlan": {
      "title": "Lista de despacho",
      "description": "Programación de despacho cargada por SAP o por OP para una fecha.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tipo": { "type": "string", "enum": ["sap", "op"], "maxLength": 10 },
        "fdesp": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archivo": { "type": "string", "maxLength": 160 },
        "items": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "allowedEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tipo",
        "fdesp",
        "archivo",
        "items",
        "ownerUid",
        "ownerEmail",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "OpExtraDoc": {
      "title": "Estado operativo de OP",
      "description": "Indicadores de producción activa y saldo en planta por OP y despacho.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "op": { "type": "string", "minLength": 1, "maxLength": 60 },
        "fdesp": { "type": "string", "maxLength": 10 },
        "enProduccion": { "type": "boolean" },
        "cantPlanta": { "type": "integer" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "allowedEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "key",
        "op",
        "fdesp",
        "enProduccion",
        "cantPlanta",
        "ownerUid",
        "ownerEmail",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceConfig": {
      "title": "Configuración del espacio de trabajo",
      "description": "Lista de habilitadores y correos autorizados del equipo.",
      "type": "object",
      "properties": {
        "nombres": { "type": "array" },
        "teamEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "allowedEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "nombres",
        "teamEmails",
        "ownerUid",
        "ownerEmail",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/registros/{regId}": {
      "schema": { "$ref": "#/entities/Registro" },
      "description": "Registros de entregas y stock inicial por despacho"
    },
    "/ingresos/{ingId}": {
      "schema": { "$ref": "#/entities/Ingreso" },
      "description": "Ingresos de producción a almacén"
    },
    "/despachos_plan/{planDocId}": {
      "schema": { "$ref": "#/entities/DespachoPlan" },
      "description": "Listas de despacho programadas por SAP u OP"
    },
    "/op_extras/{extraId}": {
      "schema": { "$ref": "#/entities/OpExtraDoc" },
      "description": "Estado En Producción y cantidad en planta por OP y fecha de despacho"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceConfig" },
      "description": "Configuración compartida de habilitadores y equipo autorizado"
    }
  }
}
